# ─────────────────────────────────────────────────────────────
# ErrorLens — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — add it to .gitignore!
# ─────────────────────────────────────────────────────────────

# ── App ────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── GitHub OAuth ───────────────────────────────────────────────
# Get these from: https://github.com/settings/developers
# → New OAuth App
# → Homepage URL: http://localhost:3000
# → Callback URL: http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# ── AWS Cognito ────────────────────────────────────────────────
# Get these from: AWS Console → Cognito → User Pools
# → App Integration → App client settings
#
# COGNITO_DOMAIN: The prefix you set under "Domain name" tab
# e.g. "myapp.auth.us-east-1.amazoncognito.com"
AWS_COGNITO_DOMAIN=your-app.auth.us-east-1.amazoncognito.com
AWS_COGNITO_CLIENT_ID=your_cognito_app_client_id
AWS_COGNITO_CLIENT_SECRET=your_cognito_app_client_secret
AWS_REDIRECT_URI=http://localhost:3000/auth/aws/callback

# ── Security ───────────────────────────────────────────────────
# A long random string used to sign session tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
